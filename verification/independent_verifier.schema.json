{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "verifier_id",
    "verifier_type",
    "timestamp",
    "claim",
    "evidence",
    "deterministic_result",
    "independent_verdict",
    "unresolved_items",
    "confidence_category"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "verifier_id": {
      "type": "string",
      "minLength": 1
    },
    "verifier_type": {
      "enum": [
        "codex",
        "claude",
        "agy_strong_model",
        "generic_cli",
        "manual_external",
        "deterministic"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "deterministic_result": {
      "enum": [
        "pass",
        "fail",
        "inconclusive"
      ]
    },
    "independent_verdict": {
      "enum": [
        "approved",
        "correction_needed",
        "inconclusive"
      ]
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence_category": {
      "enum": [
        "high",
        "medium",
        "low",
        "insufficient"
      ]
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "arguments",
        "stdout_ref",
        "stderr_ref",
        "stdout_sha256",
        "stderr_sha256",
        "exit_code",
        "files_inspected",
        "negative_tests",
        "commit_sha",
        "runtime_identity",
        "timestamp"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stdout_ref": {
          "$ref": "#/$defs/ref"
        },
        "stderr_ref": {
          "$ref": "#/$defs/ref"
        },
        "stdout_sha256": {
          "$ref": "#/$defs/sha"
        },
        "stderr_sha256": {
          "$ref": "#/$defs/sha"
        },
        "exit_code": {
          "type": "integer"
        },
        "commit_sha": {
          "type": "string",
          "minLength": 1
        },
        "runtime_identity": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "files_inspected": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "artifact_ref",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "artifact_ref": {
                "$ref": "#/$defs/ref"
              },
              "sha256": {
                "$ref": "#/$defs/sha"
              }
            }
          }
        },
        "negative_tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "command",
              "arguments",
              "exit_code",
              "expected_exit_code",
              "expected_effect",
              "observed_effect",
              "matched",
              "stdout_ref",
              "stderr_ref",
              "stdout_sha256",
              "stderr_sha256"
            ],
            "properties": {
              "command": {
                "type": "string"
              },
              "arguments": {
                "type": "array"
              },
              "exit_code": {
                "type": "integer"
              },
              "expected_exit_code": {
                "type": "integer",
                "not": {
                  "const": 0
                }
              },
              "expected_effect": {
                "type": "string",
                "minLength": 1
              },
              "observed_effect": {
                "type": "string",
                "minLength": 1
              },
              "matched": {
                "const": true
              },
              "stdout_ref": {
                "$ref": "#/$defs/ref"
              },
              "stderr_ref": {
                "$ref": "#/$defs/ref"
              },
              "stdout_sha256": {
                "$ref": "#/$defs/sha"
              },
              "stderr_sha256": {
                "$ref": "#/$defs/sha"
              },
              "expected_stdout_contains": {
                "type": "string"
              },
              "expected_stderr_contains": {
                "type": "string",
                "minLength": 1
              }
            },
            "anyOf": [
              {
                "required": [
                  "expected_stdout_contains"
                ]
              },
              {
                "required": [
                  "expected_stderr_contains"
                ]
              }
            ]
          }
        }
      }
    }
  }
}
