[
  {
    "name": "agy-agents.service",
    "scope": "system",
    "file": "/etc/systemd/system/agy-agents.service",
    "enabled": true,
    "user": "azureuser",
    "exec_start": "${HOME}/.webterminal/start_all_agents.sh",
    "description": "Antigravity WhatsApp Multi-Agent Tmux Supervisor (launches windows agy:0 to agy:13)"
  },
  {
    "name": "azure-file-explorer-tunnel.service",
    "scope": "system",
    "file": "/etc/systemd/system/azure-file-explorer-tunnel.service",
    "enabled": true,
    "user": "azureuser",
    "exec_start": "/bin/bash ${PROJECTS_ROOT}/Whatsapp_Agy_Agents/Antigravity-Global-Notifier/Cloud_VM_Live_Preview/start_tunnel.sh",
    "description": "Cloudflare Tunnel for Live Web Preview (Port 8088)"
  },
  {
    "name": "frappe-mariadb.service",
    "scope": "user",
    "file": "${HOME}/.config/systemd/user/frappe-mariadb.service",
    "enabled": true,
    "user": "azureuser",
    "exec_start": "${PROJECTS_ROOT}/Frappe-erp-Alco/runtime/mariadb/bin/mariadbd --defaults-file=${PROJECTS_ROOT}/Frappe-erp-Alco/runtime/mariadb-conf/my.cnf",
    "description": "MariaDB 11.8 for Frappe Alco bench (user-space database on port 3306)"
  },
  {
    "name": "frappe-bench.service",
    "scope": "user",
    "file": "${HOME}/.config/systemd/user/frappe-bench.service",
    "enabled": true,
    "user": "azureuser",
    "exec_start": "/bin/bash -lc 'source ${PROJECTS_ROOT}/Frappe-erp-Alco/frappe-env.sh && exec bench start'",
    "description": "Frappe bench start (HTTP port 8000, socketio port 9000, redis 11000/13000)"
  },
  {
    "name": "ask-research-api.service",
    "scope": "user",
    "file": "${HOME}/.config/systemd/user/ask-research-api.service",
    "enabled": true,
    "user": "azureuser",
    "exec_start": "/usr/bin/python3 ${PROJECTS_ROOT}/Ask-And-Research-Agent/scripts/api_service.py",
    "description": "Ask and Research Agent SQLite Database REST API Service on port 8095"
  },
  {
    "name": "backup-orchestrator.service",
    "scope": "user",
    "file": "${HOME}/.config/systemd/user/backup-orchestrator.service",
    "enabled": true,
    "user": "azureuser",
    "exec_start": "/usr/bin/python3 ${PROJECTS_ROOT}/Infrastructure-Source-of-Truth/sot backup-orchestrator run-daemon",
    "description": "Infrastructure Source of Truth Backup Orchestrator Daemon"
  },
  {
    "name": "gitpush-watcher.service",
    "scope": "user",
    "file": "${HOME}/.config/systemd/user/gitpush-watcher.service",
    "enabled": true,
    "user": "azureuser",
    "exec_start": "/usr/bin/python3 ${PROJECTS_ROOT}/Infrastructure-Source-of-Truth/sot watcher run-daemon",
    "description": "Infrastructure Source of Truth GitPush Watcher Daemon"
  }
]