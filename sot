def run_project(action):
    script = ROOT / "projects" / ("discover_unregistered_projects.py" if action == "discover" else "audit_all_projects.py")
    p = subprocess.run([sys.executable, str(script)], cwd=ROOT)
    return p.returncode


def cmd_verify(args):
    if args.help_suite:
        print("Run: ./sot verify\nRuns the provider-neutral deterministic unit and adversarial test suite.")
        return 0
    result=subprocess.run([sys.executable,"-m","unittest","discover","-s",str(ROOT/"verification/tests"),"-v"],cwd=ROOT)
    return result.returncode


def cmd_project(args):
    if args.action == "register":
        if not args.path:
            raise RuleError("project register requires --path")
        command = [sys.executable, str(ROOT / "projects/register_project.py"), "--path", args.path]
        if args.name: command += ["--name", args.name]
        if args.project_id: command += ["--id", args.project_id]
        for flag,value in (("--remote",args.remote),("--branch",args.branch),("--type",args.type),("--data-files",args.data_files),
                           ("--data-classification",args.data_classification),("--verification-profile",args.verification_profile),
                           ("--tmux",args.tmux),("--whatsapp-group",args.whatsapp_group),("--whatsapp-route",args.whatsapp_route)):
            if value: command += [flag,value]
        if args.local_only: command.append("--local-only")
        return subprocess.run(command, cwd=ROOT).returncode
    if args.action == "finalize":
        if not args.project_id:
            raise RuleError("project finalize requires --project-id and explicit approved push workflow")
        command=[sys.executable, str(ROOT / "projects/finalize_project_onboarding.py"), args.project_id]
        if args.push: command.append("--push")
        return subprocess.run(command, cwd=ROOT).returncode
    return run_project(args.action)


def cmd_artifacts(args):
    profile=profile_for(args.profile,args.home)
    state=Path(profile["resolved_roots"]["STATE_ROOT"])
    if args.action=="rollback":
        restored=artifacts.rollback(state);emit({"restored":restored,"status":"ROLLED_BACK"});return 0
    if args.action=="install":
        rows=artifacts.install(ROOT,profile,state,args.dry_run)
        emit({"installed":rows,"status":"DRY_RUN" if args.dry_run else "INSTALLED"})
        return 0
    result=artifacts.verify(ROOT,profile);emit(result)
    return 0 if result["ok"] else 2


def validate_evidence(path):
    p = subprocess.run([sys.executable, str(ROOT / "verification/validate_verifier_result.py"), path], cwd=ROOT)
    return p.returncode


def cmd_evidence(args):
    if args.action == "validate":
        if not args.path: raise RuleError("evidence validate requires a verifier result path")
        return validate_evidence(args.path)
    if not args.task_id or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", args.task_id):
        raise RuleError("evidence init/handoff requires a safe --task-id")
    if args.action == "init" and not args.request_summary.strip():
        raise RuleError("evidence init requires a concise --request-summary")
    bundle = ROOT / "verification/TASK_EVIDENCE" / args.task_id
    record_path = bundle / "record.json"
    if args.action == "init":
        if record_path.exists(): raise RuleError(f"task evidence already exists: {args.task_id}")
        bundle.mkdir(parents=True, exist_ok=False)
        now = __import__("datetime").datetime.now(__import__("datetime").timezone.utc).isoformat()
        record = {"task_id":args.task_id, "project_id":"unresolved", "project_uuid":args.project_uuid or "00000000-0000-4000-8000-000000000000",
                  "request_summary":args.request_summary, "builder":"unassigned", "tool":"unassigned", "started_at":now,
                  "ended_at":now, "changed_files":[], "commit_sha":None, "tests":[], "deterministic_result":"inconclusive",
                  "verifier_status":"pending", "verifier_identity":None, "final_verdict":"incomplete", "unresolved_items":["task data not yet recorded"]}
        record_path.write_text(json.dumps(record,indent=2)+"\n")
        emit({"task_id":args.task_id,"record":str(record_path.relative_to(ROOT)),"status":"INITIALIZED"})
        return 0
    if not record_path.is_file(): raise RuleError(f"task record missing: {args.task_id}")
    record=json.loads(record_path.read_text())
    handoff={"task_id":record.get("task_id"),"project_uuid":record.get("project_uuid"),"request_summary":record.get("request_summary"),
             "changed_files":record.get("changed_files",[]),"tests":record.get("tests",[]),"deterministic_result":record.get("deterministic_result"),
             "verifier_status":record.get("verifier_status"),"unresolved_items":record.get("unresolved_items",[]),
             "rules_index":"governance/rules", "record_sha256":__import__("hashlib").sha256(record_path.read_bytes()).hexdigest()}
    target=bundle/"handoff.json"; target.write_text(json.dumps(handoff,indent=2)+"\n")
    emit({"task_id":args.task_id,"handoff":str(target.relative_to(ROOT)),"status":"GENERATED"})
    return 0


def check_backup_assets(asset_id=None):
    data = json.loads((ROOT / "storage/DATA_ASSET_REGISTRY.json").read_text())
    assets = [a for a in data.get("assets", []) if a.get("backup_required") or a.get("remote_path")]
    if asset_id:
        assets = [a for a in assets if a.get("asset_id") == asset_id]
    provider = RcloneProvider()
    directories = {}
    for asset in assets:
        base = asset.get("primary_backup_target") or ""
        if base and base not in directories:
            try:
                directories[base] = provider.list(base)
            except Exception as exc:
                directories[base] = {"_error": str(exc)}
    results = []
    for asset in assets:
        source = Path(asset.get("source_path", ""))
        remote = asset.get("remote_path") or ""
        if not source.is_file() or not remote:
            results.append({"asset_id": asset.get("asset_id"), "status": "NOT VERIFIED", "reason": "missing local source or remote path"})
            continue
        try:
            base = asset.get("primary_backup_target") or remote.rsplit("/", 1)[0]
            listing = directories.get(base)
            if listing is None:
                listing = provider.list(base); directories[base] = listing
            if isinstance(listing, dict) and listing.get("_error"):
                raise RuntimeError(listing["_error"])
            relative = remote[len(base.rstrip("/") + "/"):]
            rows = [x for x in listing if not x.get("IsDir") and x.get("Path") == relative]
            if len(rows) != 1:
                results.append({"asset_id":asset.get("asset_id"),"status":"BACKUP_REQUIRED","reason":"exact remote object missing or ambiguous","matches":len(rows)})
                continue
            row = rows[0]
            digest = __import__("hashlib").md5()
            with source.open("rb") as stream:
                for block in iter(lambda:stream.read(1024*1024),b""): digest.update(block)
            local_md5 = digest.hexdigest(); remote_md5 = row.get("Hashes",{}).get("md5")
            size_ok = row.get("Size") == source.stat().st_size
            observed = {"exists":True,"size_match":size_ok,"remote_md5":remote_md5,"local_md5":local_md5,
                        "status":"REMOTE_CHECKSUM_VERIFIED" if size_ok and remote_md5 == local_md5 else ("REMOTE_OBJECT_VERIFIED" if size_ok else "REMOTE_UPLOAD_COMPLETE"),
                        "object_id":row.get("ID")}
            results.append({"asset_id": asset.get("asset_id"), "source_size": source.stat().st_size, **observed})
        except Exception as exc:
            results.append({"asset_id": asset.get("asset_id"), "status": "NOT VERIFIED", "reason": str(exc)})
    return {"assets_checked": len(results), "results": results,
            "status": "PASS" if results and all(x.get("status") == "REMOTE_CHECKSUM_VERIFIED" for x in results) else "FAIL"}


def cmd_backup(args):
    if args.action in {"inventory", "verify"}:
        report = check_backup_assets(args.asset)
        emit(report)
        return 0 if report["status"] == "PASS" else 2
    import tempfile, hashlib, sqlite3, gzip
    report = check_backup_assets(args.asset)
    verified = []
    failures = []
    assets = json.loads((ROOT / "storage/DATA_ASSET_REGISTRY.json").read_text()).get("assets", [])
    assets = [a for a in assets if (not args.asset or a.get("asset_id") == args.asset) and a.get("remote_path")]
    with tempfile.TemporaryDirectory(prefix="sot-restore-test-") as td:
        provider = RcloneProvider()
        for i, asset in enumerate(assets):
            path = Path(td) / f"asset-{i}"
            try:
                is_encrypted = asset.get("encryption") in {"aes-256-cbc", "required"} or asset.get("classification") == "secret"
                if is_encrypted:
                    enc_path = Path(td) / f"asset-{i}.enc"
                    provider.download(asset["remote_path"], enc_path)
                    from storage.backup_data import decrypt_file
                    decrypt_file(enc_path, path)
                else:
                    provider.download(asset["remote_path"], path)
                if path.suffix == ".db":
                    with sqlite3.connect(f"file:{path}?mode=ro", uri=True) as db:
                        integrity = db.execute("PRAGMA integrity_check").fetchone()[0]
                    ok = integrity == "ok"
                elif path.name.endswith(".sql.gz"):
                    with gzip.open(path, "rb") as stream:
                        while stream.read(1024 * 1024): pass
                    integrity = "gzip_crc_ok"; ok = True
                else:
                    integrity = "downloaded"; ok = path.is_file()
                record = {"asset_id": asset["asset_id"], "status": "REMOTE_RESTORE_VERIFIED" if ok else "FAILED", "domain_integrity": integrity}
                verified.append(record)
                if not ok: failures.append(record)
            except Exception as exc:
                failures.append({"asset_id": asset["asset_id"], "status": "FAILED", "reason": str(exc)})
    emit({"remote_checksum_inventory": report, "restore_tests": verified, "failures": failures,
          "status": "PASS" if not failures and verified else "FAIL"})
    return 0 if not failures and verified else 2


