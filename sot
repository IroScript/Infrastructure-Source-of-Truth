def emit(value, as_json=False):
    if as_json:
        print(json.dumps(value, indent=2, sort_keys=True))
    else:
        print(json.dumps(value, indent=2, ensure_ascii=False))


def profile_for(name, home=None):
    path = Path(name)
    if not path.is_file():
        path = ROOT / "deployment" / "profiles" / (name + ".json")
    env = dict(os.environ)
    if home:
        env["HOME"] = home
    profile = load_profile(path, env)
    profile["resolved_roots"]["SOT_ROOT"] = str(ROOT)
    return profile


def cmd_rules(args):
    packages = discover_packages(ROOT)
    if args.rules_command == "list":
        emit([{"rule_id": p["rule_id"], "version": p["version"], "severity": p["severity"],
               "required_proof_level": p["required_proof_level"], "manifest": str(m.relative_to(ROOT))}
              for m, p in packages], args.format == "json")
        return 0
    if args.rules_command == "validate":
        emit({"valid": True, "discovered": len(packages), "manifests": [str(m.relative_to(ROOT)) for m, _ in packages]}, args.format == "json")
        return 0
    if args.rules_command == "index":
        p = write_index(ROOT, packages)
        emit({"generated_index": str(p.relative_to(ROOT)), "packages": len(packages)}, args.format == "json")
        return 0
    profile = profile_for(args.profile, args.home)
    roots = profile["resolved_roots"]
    state = Path(roots["STATE_ROOT"])
    rule_id = getattr(args, "rule_id", None)
    chosen = [(m, p) for m, p in packages if rule_id is None or p["rule_id"] == rule_id]
    if rule_id and not chosen:
        raise RuleError(f"unknown rule id: {rule_id}")
    if args.rules_command == "install":
        installed = []
        for manifest, package in chosen:
            if args.agent_class not in package["supported_agent_classes"]:
                continue
            installed.append({"rule_id": package["rule_id"], "artifacts": install_package(ROOT, package, roots, state, args.dry_run)})
        emit(installed, args.format == "json")
        return 0
    if args.rules_command == "verify":
        results = [verify_package(ROOT, p, roots, state, Path(args.evidence_dir)) for _, p in chosen]
        emit(results, args.format == "json")
        return 0 if all(x["verdict"] == "VERIFIED" for x in results) else 2
    if args.rules_command == "sync":
        external = artifacts.install(ROOT, profile, state, args.dry_run)
        installed = []
        for manifest, package in chosen:
            if args.agent_class not in package["supported_agent_classes"]:
                continue
            installed.append({"rule_id": package["rule_id"], "artifacts": install_package(ROOT, package, roots, state, args.dry_run)})
        evidence_dir = state / "sync-evidence"
        evidence_dir.mkdir(parents=True, exist_ok=True)
        verify_results = [verify_package(ROOT, p, roots, state, evidence_dir) for _, p in chosen]
        art_verify = artifacts.verify(ROOT, profile)
        all_ok = all(x.get("verdict") == "VERIFIED" for x in verify_results) and art_verify.get("ok", False)
        emit({"status": "RULES_AND_SETTINGS_SYNCED" if all_ok else "SYNC_VERIFICATION_FAILED",
              "rules_installed": len(installed), "external_artifacts_installed": len(external),
              "rule_verifications": verify_results, "artifacts_verification": art_verify}, args.format == "json")
        return 0 if all_ok else 2
    if args.rules_command == "rollback":
        results = [{"rule_id": p["rule_id"], "restored": rollback_package(p, state)} for _, p in chosen]
        emit(results, args.format == "json")
        return 0
    raise RuleError("unsupported rules command")


def git_status():
    def run(*argv):
        p = subprocess.run(["git", "-C", str(ROOT), *argv], capture_output=True, text=True)
        return p.returncode, p.stdout.strip(), p.stderr.strip()
    rc, branch, _ = run("branch", "--show-current")
    _, head, _ = run("rev-parse", "HEAD")
    _, origin, _ = run("rev-parse", "origin/" + (branch or "main"))
    _, counts, _ = run("rev-list", "--left-right", "--count", "HEAD...origin/" + (branch or "main"))
    _, dirty, _ = run("status", "--porcelain")
    ahead, behind = map(int, counts.split()) if counts else (-1, -1)
    return {"branch": branch, "head": head, "remote_ref": origin, "ahead": ahead, "behind": behind,
            "dirty": bool(dirty), "status": "PASS" if rc == 0 and head == origin and ahead == behind == 0 and not dirty else "FAIL"}


def inspect_adapters(profile):
    import tomllib
    results = {}
    roots = dict(profile["resolved_roots"]); roots["SOT_ROOT"] = str(ROOT)
    for adapter_id in ("agy", "codex", "generic-verifier"):
        manifest = json.loads((ROOT / "adapters" / adapter_id / "adapter.json").read_text())
        command = manifest.get("version_probe", {}).get("command", [])
        exe = __import__("shutil").which(command[0]) if command else None
        version = subprocess.run([exe, *command[1:]],capture_output=True,text=True,timeout=15) if exe else None
        parsed=[]
        for template in manifest.get("config_discovery", []):
            if template.startswith("workspace/"):
                continue
            try:
                path=Path(__import__("sotlib.rules",fromlist=["resolve_template"]).resolve_template(template,roots))
            except Exception:
                continue
            if path.is_file():
                try:
                    if path.suffix==".toml": tomllib.loads(path.read_text())
                    elif path.suffix==".json": json.loads(path.read_text())
                    parsed.append({"path":str(path),"parse":"PASS"})
                except Exception as exc: parsed.append({"path":str(path),"parse":"FAIL","error":str(exc)})
        results[adapter_id]={"available":bool(version and version.returncode==0),
                             "runtime_version_observed":(version.stdout.strip().splitlines()[0] if version and version.stdout.strip() else None),
                             "config_files_parsed":parsed,"effective_enforcement":"NOT VERIFIED",
                             "capabilities":"provider/profile declaration only"}
    return results


def cmd_doctor(args):
    report = {"schema_version": "1.0.0", "profile": args.profile}
    errors = []
    try:
        profile = profile_for(args.profile, args.home)
        report["roots"] = profile["resolved_roots"]
        packages = discover_packages(ROOT)
        report["rules"] = {"discovered": len(packages), "status": "PASS"}
        external = artifacts.verify(ROOT, profile)
        report["external_artifacts"] = external
        if not external["ok"]:
            errors.append("external artifacts or managed roots are not reconciled")
        report["git"] = git_status()
        if report["git"]["status"] != "PASS":
            errors.append("SOT is dirty or not in remote parity")
        try:
            env = dict(os.environ)
            env.update(profile["resolved_roots"])
            env["AGY_SOT_ROOT"] = str(ROOT)
            p = subprocess.run([sys.executable, str(ROOT / "projects/discover_unregistered_projects.py")],
                               capture_output=True, text=True, timeout=60, env=env)
            report["orphan_scan"] = {"exit_code": p.returncode, "stdout": p.stdout, "stderr": p.stderr}
            if p.returncode:
                errors.append("orphan scan failed or found unregistered projects")
        except Exception as exc:
            report["orphan_scan"] = {"error": str(exc), "status": "NOT VERIFIED"}
            errors.append("orphan scan unavailable")
        registry = json.loads((ROOT / "projects/PROJECT_REGISTRY.json").read_text())
        statuses = {}
        for project in registry.get("projects", []):
            status = project.get("status", "MISSING")
            statuses[status] = statuses.get(status, 0) + 1
        report["projects"] = {"registered": len(registry.get("projects", [])), "lifecycle_statuses": statuses,
                              "status": "PASS" if all(x.get("status") == "ACTIVE" for x in registry.get("projects", [])) else "FAIL"}
        if report["projects"]["status"] != "PASS":
            errors.append("one or more registered projects are not ACTIVE")
        backup = check_backup_assets()
        report["backup"] = backup
        if backup["status"] != "PASS": errors.append("one or more registered external backup objects are not checksum verified")
        report["adapters"] = inspect_adapters(profile)
        report["verifiers"] = {name: bool(__import__("shutil").which(name)) for name in ("codex", "agy", "claude", "qwen")}
        report["runtime_mappings"] = {"status": "NOT VERIFIED", "reason": "runtime consumers are not yet resolved through deployment profile"}
        errors.append("runtime mapping reconciliation is not implemented for every consumer")
        report["trust"] = {"status": "NOT VERIFIED"}
        try:
            trust = subprocess.run(["bash", str(ROOT / "trust/verify_trust_baseline.sh")], capture_output=True, text=True,
                                   env={**os.environ, **profile["resolved_roots"], "HOME": profile["resolved_roots"]["HOME"], "SOT_PROFILE": args.profile}, timeout=60)
            report["trust"] = {"status": "PASS" if trust.returncode == 0 else "FAIL", "exit_code": trust.returncode,
                               "stdout": trust.stdout, "stderr": trust.stderr}
            if trust.returncode:
                errors.append("trust baseline verification failed")
        except Exception as exc:
            report["trust"] = {"status": "NOT VERIFIED", "error": str(exc)}
            errors.append("trust baseline verification unavailable")
        report["docker"] = {"available": bool(__import__("shutil").which("docker")), "status": "NOT VERIFIED"}
        if not report["docker"]["available"]:
            errors.append("Docker recovery is unavailable on this host")
        try:
            from gitpush_watcher.watcher import GitPushWatcher
            report["watcher"] = GitPushWatcher(ROOT).get_health_report()
        except Exception as exc:
            report["watcher"] = {"status": "NOT VERIFIED", "error": str(exc)}
        try:
            from gitpush_watcher.cloud_parity import CloudParityAuditor
            report["cloud_parity"] = CloudParityAuditor(ROOT).audit()
        except Exception as exc:
            report["cloud_parity"] = {"overall_verdict": "FAIL", "error": str(exc)}
    except Exception as exc:
        errors.append(str(exc))
        report["error"] = str(exc)
    report["errors"] = errors
    report["verdict"] = "PASS" if not errors else "FAIL"
    emit(report, args.format == "json")
    return 0 if not errors else 2


