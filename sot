    if args.target == "docker":
        docker = __import__("shutil").which("docker")
        if not docker:
            emit({"docker_recovery": "NOT VERIFIED", "reason": "Docker CLI is not installed", "profile": args.profile})
            return 2
        compose = subprocess.run([docker, "compose", "version"], capture_output=True, text=True)
        if compose.returncode:
            emit({"docker_recovery": "NOT VERIFIED", "reason": "Docker Compose plugin unavailable", "stderr": compose.stderr})
            return 2
        emit({"docker_recovery": "NOT VERIFIED", "reason": "No validated compose recovery manifest is currently declared", "compose_version": compose.stdout.strip()})
        return 2
    profile = profile_for(args.profile, args.home)
    roots = profile["resolved_roots"]
    packages = discover_packages(ROOT)
    installed = []
    for _, package in packages:
        if args.agent_class in package["supported_agent_classes"]:
            installed.append(install_package(ROOT, package, roots, Path(roots["STATE_ROOT"]), args.dry_run))
    external = artifacts.install(ROOT, profile, Path(roots["STATE_ROOT"]), args.dry_run)

    symlinks_file = ROOT / "infrastructure/SYMLINKS.json"
    recreated_symlinks = []
    if symlinks_file.is_file():
        try:
            symlinks_data = json.loads(symlinks_file.read_text(encoding="utf-8"))
            for item in symlinks_data:
                alias = item["alias_path"]
                raw_target = item["raw_target"]
                for k, v in roots.items():
                    alias = alias.replace("${" + k + "}", v)
                alias_path = Path(alias)
                if not item.get("is_relative", False):
                    target = raw_target
                    for k, v in roots.items():
                        target = target.replace("${" + k + "}", v)
                else:
                    target = raw_target
                if not args.dry_run:
                    alias_path.parent.mkdir(parents=True, exist_ok=True)
                    if alias_path.is_symlink() or alias_path.is_file():
                        alias_path.unlink()
                    elif alias_path.is_dir():
                        shutil.rmtree(alias_path)
                    try:
                        alias_path.symlink_to(target)
                        recreated_symlinks.append(str(alias_path))
                    except Exception:
                        pass
                else:
                    recreated_symlinks.append(str(alias_path))
        except Exception:
            pass

    service_src = ROOT / "gitpush_watcher/gitpush-watcher.service"
    service_installed = False
    if service_src.is_file():
        systemd_user_dir = Path(roots["HOME"]) / ".config/systemd/user"
        systemd_dest = systemd_user_dir / "gitpush-watcher.service"
        if not args.dry_run:
            systemd_user_dir.mkdir(parents=True, exist_ok=True)
            systemd_dest.write_bytes(service_src.read_bytes())
            service_installed = systemd_dest.is_file()
        else:
            service_installed = True

    if args.dry_run:
        emit({"status": "DRY_RUN", "rules": len(installed), "external_artifacts": len(external),
              "symlinks_recreated": len(recreated_symlinks), "systemd_service_installed": service_installed})
        return 0
    result = artifacts.verify(ROOT, profile)
    if result["ok"]:
        legacy = subprocess.run(["bash", str(ROOT / "trust/verify_trust_baseline.sh")],
                                capture_output=True, text=True, env={**os.environ, **profile["resolved_roots"],
                                "HOME": profile["resolved_roots"]["HOME"], "SOT_PROFILE": args.profile})
        result["legacy_trust_verification"] = {"exit_code": legacy.returncode,
                                                "stdout": legacy.stdout, "stderr": legacy.stderr}
        if legacy.returncode:
            result["ok"] = False
    emit({"status": "BOOTSTRAP_INCOMPLETE" if not result["ok"] else "BOOTSTRAP_INSTALLED",
          "rules": len(installed), "external_artifacts": len(external),
          "symlinks_recreated": len(recreated_symlinks), "systemd_service_installed": service_installed,
          "verification": result})
    return 2 if not result["ok"] else 0


if __name__ == "__main__":
    raise SystemExit(main())
