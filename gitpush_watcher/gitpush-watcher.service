[Unit]
Description=Infrastructure Source of Truth GitPush Watcher Daemon
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/azureuser/IroScript_Projects/Infrastructure-Source-of-Truth
ExecStart=/usr/bin/python3 /home/azureuser/IroScript_Projects/Infrastructure-Source-of-Truth/sot watcher run-daemon
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
