[Unit]
Description=Infrastructure Source of Truth GitPush Watcher Daemon
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/IroScript_Projects/Infrastructure-Source-of-Truth
ExecStart=/usr/bin/python3 %h/IroScript_Projects/Infrastructure-Source-of-Truth/sot watcher run-daemon
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=GIT_TERMINAL_PROMPT=0

[Install]
WantedBy=default.target

