{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "schema_version",
    "rule_id",
    "version",
    "name",
    "scope",
    "severity",
    "enabled",
    "supported_agent_classes",
    "artifacts",
    "load_order",
    "precedence",
    "activation",
    "reload_requirement",
    "required_proof_level",
    "expected_effect",
    "positive_probe",
    "negative_probe",
    "supersedes",
    "rollback"
  ],
  "properties": {
    "manifest_version": {
      "const": "1.0.0"
    },
    "rule_id": {
      "type": "string",
      "pattern": "^RULE-[A-Z0-9][A-Z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "supported_agent_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "source",
          "destination_template",
          "mode",
          "sha256",
          "kind",
          "permissions"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "destination_template": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "pattern": "^[0-7]{4}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "enum": [
              "documentation",
              "config",
              "python",
              "shell",
              "hook",
              "systemd",
              "agent_config",
              "data"
            ]
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "load_order": {
      "type": "integer"
    },
    "precedence": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "activation": {
      "type": "object",
      "required": [
        "method",
        "argv",
        "expected_exit_code"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "expected_exit_code": {
          "type": "integer"
        }
      }
    },
    "reload_requirement": {
      "enum": [
        "none",
        "reload",
        "restart",
        "adapter_specific"
      ]
    },
    "required_proof_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "expected_effect": {
      "type": "string",
      "minLength": 1
    },
    "positive_probe": {
      "$ref": "#/$defs/probe"
    },
    "negative_probe": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "required": [
            "expected_effect"
          ],
          "properties": {
            "expected_effect": {
              "type": "string",
              "minLength": 1
            },
            "expected_stdout_contains": {
              "type": "string"
            },
            "expected_stderr_contains": {
              "type": "string"
            }
          }
        }
      ]
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback": {
      "type": "object",
      "required": [
        "strategy"
      ]
    },
    "commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "const": "1.0.0"
    }
  },
  "$defs": {
    "probe": {
      "type": "object",
      "required": [
        "argv",
        "expected_exit_code"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "expected_exit_code": {
          "type": "integer"
        },
        "expected_effect": {
          "type": "string"
        },
        "expected_stdout_contains": {
          "type": "string"
        },
        "expected_stderr_contains": {
          "type": "string"
        }
      }
    }
  }
}
