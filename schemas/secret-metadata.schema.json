{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["secret_id", "consumer", "runtime_destination_template", "permissions", "encrypted_external_reference", "key_source_reference", "recovery_method", "verification_state"],
  "properties": {
    "secret_id": {"type": "string", "pattern": "^SECRET-[A-Z0-9][A-Z0-9-]+$"},
    "consumer": {"type": "string", "minLength": 1},
    "runtime_destination_template": {"type": "string", "minLength": 1},
    "permissions": {"type": "array", "items": {"type": "string"}},
    "encrypted_external_reference": {"type": ["string", "null"]},
    "key_source_reference": {"type": ["string", "null"]},
    "recovery_method": {"type": "string", "minLength": 1},
    "verification_state": {"enum": ["NOT_CONFIGURED", "ENCRYPTED_BACKUP_VERIFIED", "RECOVERY_TEST_PENDING", "RECOVERY_VERIFIED"]}
  }
}
